@inherits LayoutComponentBase
@using Space_Shooter_Website.Client.Added_Layouts
@using Space_Shooter_Website.Client.Support_Classes
@using Model.Entitys
@inject IJSRuntime JS
@inject Session session

<div class="game-container">
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/Assets/icon.png" id="icon" class="nav_text logo" />
                <img src="/Assets/Header.png" id="header" class="nav_text" />
            </a>

            <div class="collapse navbar-collapse" id="navbarNav" style="width:100vw">
                <ul class="navbar-nav" style="width:80vw">
                    <li class="nav-item nav_text">
                        <button type="button" class="top button" @onclick="OpenSettings">
                            <img alt="settings" src="/Assets/UI Icons/cogwheel.png" class="top_button_pic" />
                        </button>
                    </li>
                    <li class="nav-item nav_text">
                        <div class="m_card" id="life_bar">
                            <img src="/Assets/Game Elements/Images/player.png" alt="Player Avatar" class="top_button_pic" id="nav_player_pic" />
                            <span id="life_text" class="nav_text">x @Health.ToString("D3")</span>
                        </div>
                    </li>
                    <li class="nav-item nav_text">
                        <div class="progress-bar-container">
                            <div id="progress-bar" style="width: @(Progress)%">
                                @(IsEndless ? "Endless!" : Progress == 0 ? "Won!" : $"{Progress}%")
                            </div>
                        </div>
                    </li>
                    <li class="nav-item nav_text">
                        <span id="score_board" class="nav_text">@Score.ToString("D6")</span>
                    </li>
                    <li class="nav-item nav_text">
                        <span id="level" class="nav_text">Level @CurrentLevel.ToString("D2")</span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <div style="height:16vh"></div>
        @Body
    </main>

    @* Settings Popup *@
    @if (ShowSettings)
    {
        <div class="popup" id="settings" style="display: block;">
            <div class="m_container">
                <div class="m_card">
                    <button type="button" class="button top" @onclick="CloseSettings">
                        <img alt="back" src="/Assets/Main_Menu/Setting/Backward_BTN.png" class="top_button_pic" />
                    </button>
                    <img alt="Settings" class="pic_text" src="/Assets/Main_Menu/Setting/Header.png" />
                </div>
                @* Add Sound/Music buttons here similarly *@
                <div class="m_card">
                    <button type="button" @onclick="CloseSettings" class="button">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // These properties would ideally come from a Scoped Service or CascadingValue
    public int Health { get; set; } = 5;
    public int Score { get; set; } = 0;
    public int Progress { get; set; } = 0;
    public int CurrentLevel { get; set; } = 1;
    public bool IsEndless { get; set; } = false;
    public bool ShowSettings { get; set; } = false;
    private Player currentPlayer;

    protected override void OnInitialized()
    {
        // 1. Get the player
        currentPlayer = session.CurrentUser as Player;
    }

    private DotNetObjectReference<GameLayout>? objRef;
    public void Dispose() => objRef?.Dispose();

    [JSInvokable]
    public void UpdateHUD(int health, int score, int level, int killed, int created, bool isEndless)
    {
        Health = health;
        Score = score;
        CurrentLevel = level;
        IsEndless = isEndless;

        // Calculate progress logic
        if (created > 0 && !isEndless)
        {
            double livingPercent = (1.0 - ((double)killed / created));
            Progress = (int)Math.Floor(livingPercent * 100);
        }
        else
        {
            Progress = 100;
        }

        // Tell Blazor to re-render the HTML with new values
        StateHasChanged();
    }

    private void OpenSettings() => ShowSettings = true;
    private void CloseSettings() => ShowSettings = false;

    private void ToggleMusic()
    {
        if (currentPlayer != null)
        {
            currentPlayer.IsMusicOn = !currentPlayer.IsMusicOn;

            StateHasChanged(); // Force UI refresh for the icon toggle
        }
    }

    private void ToggleSound()
    {
        if (currentPlayer != null)
        {
            currentPlayer.IsSoundOn = !currentPlayer.IsSoundOn;
            StateHasChanged();
        }
    }
}