@page "/game"
@using Space_Shooter_Website.Client.Added_Layouts
@using Space_Shooter_Website.Client.Support_Classes
@using Model.Entitys
@using Client_Manager___API;
@layout GameLayout
@inject IJSRuntime JS
@inject Session session
@inject IApiService api
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Space Shooter - Game</PageTitle>

<div class="game-container">
    <section id="game_section">

    </section>
</div>

@code {
    private Player? currentPlayer;
    private bool IsGameStarted = false;

    private DotNetObjectReference<Game>? objRef;
    public async void Dispose()
    {
        IsGameStarted = false; // Reset the flag so it can restart next time
        //close game
        _ = JS.InvokeVoidAsync("DestroyGame"); 
        // Clean up the reference when the user navigates away
        objRef?.Dispose();
        //updated screen
        session.OnGameStateChanged -= StateHasChanged;
    }

    [JSInvokable]
    public async Task SaveGameResult(bool won)
    {
        if (api is ApiService apiService && currentPlayer != null)
        {
            session.SaveRun(apiService, won);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // If it's the first time OR we are returning to the page and game isn't running
        if (firstRender || !IsGameStarted){
            IsGameStarted = true;
            await Task.Delay(300);//time for DOM to load
            currentPlayer = session.CurrentUser as Player;

            if (currentPlayer != null)
            {
                // Dispose old reference if it exists to be safe
                objRef?.Dispose();
                // Create the reference to THIS C# instance
                objRef = DotNetObjectReference.Create(this);

                // Start the game and pass the helper to JS
                await JS.InvokeVoidAsync("RunGame",
                    objRef,
                    currentPlayer.IsMusicOn,
                    currentPlayer.IsSoundOn,
                    session.SelectedLevel
                );
            }
        }
    }

    [JSInvokable]
    public void ToggleSettingsMenu()
    {
        session.ToggleSettings(JS);
    }

    [JSInvokable]
    public void UpdateHUD(int hp, int score, int level, int shield, int blasters, int killed, int maxEnemies, bool isEndless)
    {
        session.UpdateGameStats(hp, score, level, shield, blasters, killed, maxEnemies, isEndless);
    }
}