    private void CheckRules(Dictionary<string, object> dataSource, Type EntityType)
    {
        // 2. Map validation only if we are targeting relevant objects
        if (typeof(User).IsAssignableFrom(EntityType))//if User father to EntityType
        {
            // Extract core fields safely from our property data source
            string email = dataSource.TryGetValue("Email", out var eVal) ? eVal?.ToString() ?? "" : "";
            string password = dataSource.TryGetValue("Password", out var pVal) ? pVal?.ToString() ?? "" : "";
            string username = dataSource.TryGetValue("Username", out var uVal) ? uVal?.ToString() ?? "" : "";
            string id = dataSource.TryGetValue("Id", out var idVal) ? idVal?.ToString() ?? "" : "";

            DateTime birthday = DateTime.MinValue;
            if (dataSource.TryGetValue("Birthday", out var bVal))
            {
                if (bVal is DateTime dt) birthday = dt;
                else if (bVal != null) DateTime.TryParse(bVal.ToString(), out birthday);
            }

            // --- EMPTY FIELDS VALIDATION ---
            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password) ||
                string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(id) || birthday == DateTime.MinValue)
            {
                brokenRules.Add("All fields are required, so other checks are stopped!");
                return; // Stop further granular checks if essential data is missing
            }

            // --- ID LENGTH VALIDATION ---
            if (id.Length < 5)
            {
                brokenRules.Add("ID must be at least 5 characters long.");
            }

            // --- EMAIL METRIC AND POSITION VALIDATIONS ---
            var emailFormat = new System.Text.RegularExpressions.Regex(@"^[\w-.]+@([\w-.]+\.)+[a-zA-Z]{2,}$");
            int attIndex = email.IndexOf('@');
            int eLength = email.Length;

            if (eLength < 8)
            {
                brokenRules.Add($"Email must be at least 8 characters long (currently {eLength}).");
            }
            if (eLength > 35)
            {
                brokenRules.Add($"Email cannot exceed 35 characters (currently {eLength}).");
            }
            if (attIndex < 2)
            {
                brokenRules.Add("The '@' symbol must have at least 2 characters before it.");
            }
            if (attIndex >= eLength - 2)
            {
                brokenRules.Add("The '@' symbol must have at least 2 characters after it.");
            }
            if (email.LastIndexOf('.') == -1)
            {
                brokenRules.Add("Email is missing a dot ('.') domain separator.");
            }
            if (email.IndexOf('.', attIndex + 2) == (attIndex + 2))
            {
                brokenRules.Add("The dot ('.') cannot immediately follow the '@' symbol.");
            }
            if (email.IndexOf('.', attIndex + 2) == -1)
            {
                brokenRules.Add("The email domain must contain a dot ('.') after the '@' symbol.");
            }
            if (email.LastIndexOf('.') >= eLength - 2)
            {
                brokenRules.Add("The email domain suffix must be at least 2 characters long.");
            }
            if (email.IndexOf('.') < 2)
            {
                brokenRules.Add("The email prefix must have at least 2 characters before the first dot.");
            }
            if (!emailFormat.IsMatch(email))
            {
                brokenRules.Add("Please enter a valid email address format (e.g., example@domain.com).");
            }

            // --- COMPLEX ENCRYPTED PASSWORD VALIDATIONS ---
            const int minPasswordLength = 8, maxPasswordLength = 20,
                hashConstLength = 64;
            if (password.Length == hashConstLength)//is hash 
            {
                brokenRules.Add($"Password is a Hash.\n THIS IS ONLY A NOTICE! \nNot necessarily an error.");
            }
            else
            {
                if (password.Length < minPasswordLength)
                {
                    brokenRules.Add($"Password must be at least {minPasswordLength} characters long.");
                }
                if (password.Length > maxPasswordLength)
                {
                    brokenRules.Add($"Password cannot exceed {maxPasswordLength} characters.");
                }
                if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[^\w\s]"))
                {
                    brokenRules.Add("Password must contain at least one special character.");
                }
                if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[\d]"))
                {
                    brokenRules.Add("Password must contain at least one number.");
                }
                if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[A-Z]"))
                {
                    brokenRules.Add("Password must contain at least one uppercase letter.");
                }
                if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[a-z]"))
                {
                    brokenRules.Add("Password must contain at least one lowercase letter.");
                }
            }

            // --- AGE VALIDATIONS ---
            DateTime now = DateTime.Now;
            double msIn120Years = 1000.0 * 60 * 60 * 24 * 365.25 * 120;
            DateTime date120YearsAgo = now.AddMilliseconds(-msIn120Years);

            if (birthday < date120YearsAgo)
            {
                brokenRules.Add("Invalid birth date: Age cannot exceed 120 years.");
            }
            if (birthday >= now.Date)
            {
                brokenRules.Add("Invalid birth date: Birth date cannot be in the future.");
            }
        }

        if (typeof(RunInfo).IsEquivalentTo(EntityType))
        {
            // Extract core fields safely from our property data source
            int currentShieldLevel = 0;
            if (dataSource.TryGetValue("CurrentShieldLevel", out var shieldVal))
            {
                if (shieldVal is int sInt) currentShieldLevel = sInt;
                else int.TryParse(shieldVal?.ToString(), out currentShieldLevel);
            }

            int currentBlasterCount = 0;
            if (dataSource.TryGetValue("CurrentBlasterCount", out var blasterVal))
            {
                if (blasterVal is int bInt) currentBlasterCount = bInt;
                else int.TryParse(blasterVal?.ToString(), out currentBlasterCount);
            }

            int currentHP = 0;
            if (dataSource.TryGetValue("CurrentHP", out var hpVal))
            {
                if (hpVal is int hInt) currentHP = hInt;
                else int.TryParse(hpVal?.ToString(), out currentHP);
            }

            // --- CHECK_RunsInfoTbl_CurrentShieldLevel_Min ---
            if (currentShieldLevel < 0)
            {
                brokenRules.Add($"Current Shield Level cannot be negative (supplied: {currentShieldLevel}).");
            }

            // --- CK_RunsInfoTbl_CurrentBlasterCount_Range ---
            if (currentBlasterCount < 1 || currentBlasterCount > 9)
            {
                brokenRules.Add($"Current Blaster Count must be between 1 and 9 (supplied: {currentBlasterCount}).");
            }

            // --- CK_RunsInfoTbl_CurrentHP_Min ---
            if (currentHP < 0)
            {
                brokenRules.Add($"Current HP cannot be negative (supplied: {currentHP}).");
            }
        }
    }
    #endregion
}