@page "/Admin Dashboard"
@inject IApiService api
@inject NavigationManager NavManager
@inject Session session
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Admin Dashboard</PageTitle>
<section class="admin-dashboard">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col text-center">
                <h1 class="display-4 text" style="margin-bottom:0px;">Dashboard</h1>
                <p class="text-muted text" style="margin-bottom:0px;">Managing: @activeTab</p>
            </div>
        </div>

        @if (isLoading)
        @*מסך טעינה*@
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading Data...</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(pageErrorMessage))
        @*מסך שגיאה*@
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa fa-exclamation-triangle-fill me-2"></i>
                <strong>Error:</strong> @pageErrorMessage
                <button type="button" class="btn-close" @onclick="ResetPage" aria-label="Close"></button>
            </div>
        }
        else if (!string.IsNullOrEmpty(pageSuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa fa-check-circle-fill me-2"></i>
                <strong>Success!</strong> @pageSuccessMessage
                <button type="button" class="btn-close" @onclick="() => pageSuccessMessage = null"></button>
            </div>
        }
        else if (isSelectByIdWindow)
        @*מסך Select By Id*@
        {
            <div class="card mt-4 border-primary shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Details for Idx: @targetId</h5>
                </div>
                <div class="card-body bg-light">
                    <div class="row">
                        @foreach (var prop in GetSingleProperties())
                        {
                            <div class="col-md-4 mb-3">
                                <label class="fw-bold text-dark">@prop.Name:</label>
                                <div class="p-2 border rounded bg-white text-dark">
                                    @prop.GetValue(SingleEntity)
                                </div>
                            </div>
                        }
                    </div>
                    <button class="btn btn-secondary btn-sm" @onclick="() => isSelectByIdWindow = false">Clear View</button>
                </div>
            </div>
        }
        else if (isInsertMode && !isLookupMode && !isNestedInsertMode)
        @*מסך Insert*@
        {
            @* the fields have no input protection!!! *@
            <div class="card mb-4 border-success shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add New Entry to @activeTab</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var prop in GetCurrentProperties())
                        {
                            @RenderPropertyInput(prop, newEntryData)
                        }
                    </div>
                    <div class="mt-2">
                        <button class="btn btn-primary" @onclick="TryInsert">Save Entry</button>
                        <button class="btn btn-secondary" @onclick="ResetPage">Cancel</button>
                    </div>
                </div>
            </div>
        }
        else if (isLookupMode)
            @*מסך Lookup *@ {
            <div class="lookup-backdrop">
                <div class="lookup-modal shadow-lg">
                    <div class="lookup-header text-center" style="max-width:94%">
                        <h3 class="title">Select @CurrentNestedType?.Name</h3>
                        <p class="text-muted small">Pick a record to link to the current entry</p>
                    </div>

                    <div class="lookup-body custom-scrollbar" style="max-width:94%">
                        @if (!lookupData.Any())
                        {
                            <div class="text-center p-5">
                                <div class="spinner-border text-primary mb-2"></div>
                                <p class="text">Loading records...</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in lookupData)
                                {
                                    <button class="lookup-item" style="background-color:#00d4ff" @onclick="() => SelectLookupItem(item)">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text">@item.ToString()</span>
                                            <i class="fa fa-chevron-right text-primary"></i>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                </div>

                <div class="lookup-footer">
                    <button class="btn btn-outline-danger w-100" @onclick="ReturnFromNestedLookup">
                        <i class="fa fa-x-circle me-2"></i>Cancel Lookup
                    </button>
                </div>
            </div>
        </div>
                } else if (isNestedInsertMode)
        @*מסך הוספת ישות של Insert*@
        {
            @* the fields have no input protaction!!! *@
            <div class="NestedInsert-modal shadow-lg text-center">
                <div class="NestedInsert-header">
                    <h3 class="title">New @(CurrentNestedType?.Name ?? "Entry")</h3>
                </div>
                <div class="card mb-4 border-success shadow" style="max-width:94%">
                    @foreach (var prop in GetPropertiesCached(CurrentNestedType))
                    {
                        @RenderPropertyInput(prop, CurrentNestedData)
                    }
                </div>
                <div class="lookup-footer d-flex gap-2">
                    <button class="btn btn-success flex-grow-1" @onclick="TryToSendNestedToField"> Apply </button>
                    <button class="btn btn-outline-secondary" @onclick="ReturnFromNestedInsert"> Cancel </button>
                </div>
            </div>
        }
        else if (isEditMode && SingleEntity != null)
        @* Edit Mode Modal *@
        {
            <div class="lookup-backdrop">
                <div class="lookup-modal shadow-lg border-warning" style="border-top: 5px solid #ffc107;">
                    <div class="lookup-header bg-dark text-warning border-bottom border-warning">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="title mb-0">Update @activeTab.ToUpper()</h3>
                            <span class="badge bg-warning text-dark">ID: @targetId</span>
                        </div>
                        <p class="small mb-0 opacity-75">Modify fields to update the record. Supports Nested Lookups.</p>
                    </div>

                    <div class="lookup-body custom-scrollbar p-4 bg-dark">
                        @foreach (var prop in GetPropertiesCached(SingleEntity.GetType()))
                        {
                            @RenderPropertyInput(prop, editData)
                        }
                    </div>

                    <div class="lookup-footer d-flex gap-2 bg-dark border-top border-warning">
                        <button class="btn btn-warning flex-grow-1 fw-bold" @onclick="TryUpdate">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Save Changes
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="() => { isEditMode = false; editData.Clear(); }">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        @*מסך Select ALL*@
        {
            <div class="card shadow">
                <div class="card-header bg-dark">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "users" ? "active" : "")"
                                    @onclick='() => SetTab("users")'>
                                Users
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "admins" ? "active" : "")"
                                    @onclick='() => SetTab("admins")'>
                                Admins
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "players" ? "active" : "")"
                                    @onclick='() => SetTab("players")'>
                                Players
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "groups" ? "active" : "")"
                                    @onclick='() => SetTab("groups")'>
                                Groups
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "playersAndgroups" ? "active" : "")"
                                    @onclick='() => SetTab("playersAndgroups")'>
                                PlayersAndGroups
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "profileEditRequests" ? "active" : "")"
                                    @onclick='() => SetTab("profileEditRequests")'>
                                ProfileEditRequests
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "requestsData" ? "active" : "")"
                                    @onclick='() => SetTab("requestsData")'>
                                RequestsData
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "runsInfo" ? "active" : "")"
                                    @onclick='() => SetTab("runsInfo")'>
                                RunsInfo
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 border-end">
                            <h4 class="title">Controls:</h4>
                            <div class="form-group mb-3">
                                <label class="subtitle">Target ID:</label>
                                <EditForm Model="this" OnValidSubmit="FetchItemById">
                                    <!--allow enter to submit-->
                                    <div class="input-group">
                                        <input type="number" class="form-control" @bind="targetId" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-search"></i>
                                            Go
                                        </button>
                                    </div>
                                </EditForm>
                            </div>
                            <div class="d-grid gap-2">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-success" @onclick="RefreshTable">Refresh Table</button>

                                    @if (targetId > 0)
                                    {
                                        <button class="btn btn-danger" @onclick="HandleDelete">
                                            Delete ID: @targetId from @activeTab
                                        </button>
                                        <button class="btn btn-warning" @onclick="HandleUpdate">
                                            Update ID: @targetId from @activeTab
                                        </button>
                                    }
                                    else
                                    {
                                        <p class="text">Search for an entity, if you wish to delete or update it.</p>
                                    }

                                    <button class="btn btn-success" @onclick="OpenInsertModal">Add New Entry</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="table-responsive" style="max-height: 600px;">
                                <table class="table table-hover table-striped border">
                                    <thead class="table-dark">
                                        <tr>
                                            @foreach (var prop in GetCurrentProperties())
                                            {
                                                <th class="subtitle">@prop.Name</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in GetCurrentData())
                                        {
                                            <tr>
                                                @foreach (var prop in GetCurrentProperties())
                                                {
                                                    <td class="text">@prop.GetValue(item)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (showValidationPopup)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-warning shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title font-weight-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i> Validation Alert
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelPopup" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">The following data validation rules or warnings were triggered:</p>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var rule in brokenRules)
                        {
                            <li class="list-group-item text-danger border-0 ps-0">
                                <i class="fas fa-times-circle me-2"></i> @rule
                            </li>
                        }
                    </ul>

                    <!-- Informative note explaining DB behavior -->
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>Note:</strong>
                            Overriding these warnings will submit the data,
                            but any values violating database constraints (mostly integer ranges)
                            will automatically reset to system defaults."
                    </div>

                    <p class="mb-0 fw-bold text-secondary">Do you want to override these rules and proceed anyway?</p>
                </div>                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CancelPopup">
                        <i class="fas fa-times me-1"></i> Cancel & Fix
                    </button>
                    <button type="button" class="btn btn-warning text-dark font-weight-bold" @onclick="ConfirmAndExecute">
                        <i class="fas fa-check me-1"></i> Confirm & Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    #region page_vars:
    // --- Popup UI State ---
    private bool showValidationPopup = false;
    private List<string> brokenRules = new();
    private Func<Task>? pendingAction = null; // Stores the original method to run if overridden


    private bool isSelectByIdWindow = false;
    private bool isEditMode = false;
    private Dictionary<string, object> editData = new();
    #endregion

    #region general funcs
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every time a new page loads, we ensure the exit handler is armed
        if (firstRender)
        {
            await JS.InvokeVoidAsync("resetInternalNav");
        }
    }
    #endregion


    #region Insert
    #region base
    private void OpenInsertModal()
    {
        isLoading = true;
        pageErrorMessage = null;
        newEntryData.Clear();

        //default values to all fields 
        newEntryData = InitializeDefaultDictionary(_tableRegistry[activeTab].EntityType);

        isInsertMode = true;
        isLoading = false;
    }

    private async Task TryInsert()
    {
        brokenRules.Clear();

        CheckRules(newEntryData, _tableRegistry[activeTab].EntityType);

        if (brokenRules.Any())
        {
            pendingAction = HandleInsert;
            showValidationPopup = true;
        }
        else
        {
            await HandleInsert();
        }
    }

    private async Task HandleInsert()
    {
        // 1. Safety check: ensure the current tab is actually in our registry
        if (!_tableRegistry.TryGetValue(activeTab, out var config))
        {
            pageErrorMessage = "Insert Error: Table mapping not found for " + activeTab;
            return;
        }

        isLoading = true;
        pageErrorMessage = null;

        try
        {
            // 2. Map the data from the UI dictionary to the specific Entity type
            // Use the EntityType stored in the registry config
            var newEntity = MapDataToEntity(newEntryData, config.EntityType);

            // 3. Execute the Insert using the delegate from the registry
            // This replaces the entire switch statement
            var result = await config.Insert(newEntity);

            if (result.rows > 0)
            {
                isInsertMode = false;
                newEntryData.Clear();
                await RefreshData();

                pageSuccessMessage = $"Successfully added new record to {activeTab}!";

                // Auto-clear success message
                _ = Task.Delay(2500).ContinueWith(_ =>
                {
                    pageSuccessMessage = null;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                pageErrorMessage = result.error ?? "Insert failed.";
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = "Insert Error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private BaseEntity MapDataToEntity(Dictionary<string, object> Data, Type entityType)
    {
        var entity = (BaseEntity)Activator.CreateInstance(entityType)!;
        // Use your cached properties for better performance
        var props = GetPropertiesCached(entityType);

        foreach (var prop in props)
        {
            if (Data.TryGetValue(prop.Name, out var value) && value != null)
            {
                // 1. Handle Passwords
                if (prop.Name.Contains("Password", StringComparison.OrdinalIgnoreCase))
                {
                    prop.SetValue(entity, TextHasher.Hash(value.ToString()));
                    continue;
                }

                var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

                // 2. Handle Nested Entities (Recursion)
                if (value is Dictionary<string, object> nestedDict && targetType.IsSubclassOf(typeof(BaseEntity)))
                {
                    var nestedEntity = MapDataToEntity(nestedDict, targetType);
                    prop.SetValue(entity, nestedEntity);
                }
                // 3. Handle Primitive Types (int, string, etc.)
                else
                {
                    try
                    {
                        var convertedValue = Convert.ChangeType(value, targetType);
                        prop.SetValue(entity, convertedValue);
                    }
                    catch (Exception ex)
                    {
                        pageErrorMessage = $"Mapping Error on '{prop.Name}': {ex.Message}";
                    }
                }
            }
        }
        return entity;
    }
    #endregion

    #region Lookup
    /// <summary>
    /// Opens a list of existing entities to choose from
    /// </summary>
    /// <param name="type">Table Type</param>
    /// <param name="key">Perant Key</param>
    /// <returns></returns>
    private async Task OpenLookup(Type type, string key)
    {
        // 1. Find the tab name by searching the registry for the matching EntityType
        var targetTabEntry = _tableRegistry.FirstOrDefault(x => x.Value.EntityType == type);

        if (targetTabEntry.Key != null)
        {
            typeStack.Push(type);
            keyStack.Push(key);

            string originalTab = activeTab;
            string targetTab = targetTabEntry.Key;

            isLoading = true;
            try
            {
                // 2. Temporarily switch tabs to utilize existing fetching logic
                activeTab = targetTab;

                // Ensure we have the latest data for this specific entity type
                await RefreshData();
                lookupData = GetCurrentData();

                // 3. Revert state and open UI
                activeTab = originalTab;
                isLookupMode = true;
            }
            catch (Exception ex)
            {
                pageErrorMessage = $"Lookup Error for {type.Name}: {ex.Message}";
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            pageErrorMessage = $"Lookup Error: Type '{type.Name}' is not registered in the Table Registry.";
        }
    }

    private void SelectLookupItem(object item)
    {
        // 1. Safety check: ensure we have context for where this item belongs
        if (!keyStack.Any())
        {
            pageErrorMessage = "Lookup Error: Navigation context lost.";
            isLookupMode = false;
            return;
        }

        string fieldName = keyStack.Pop();
        typeStack.Pop();

        try
        {
            // 2. Assign the item to the appropriate place
            // If we have a nestingStack, we are inside a sub-form (Level 2+)
            if (nestingStack.Any())
            {
                nestingStack.Peek()[fieldName] = item;
            }
            else if (isEditMode) // update mode
            {
                editData[fieldName] = item;
            }
            else // insert mode
            {
                newEntryData[fieldName] = item;
            }

            isLookupMode = false;
            pageSuccessMessage = $"Linked {item.GetType().Name} to {fieldName}";

            // Quick auto-clear of the "Linked" notification
            _ = Task.Delay(1500).ContinueWith(_ => { pageSuccessMessage = null; InvokeAsync(StateHasChanged); });
        }
        catch (Exception ex)
        {
            pageErrorMessage = $"Assignment Error: {ex.Message}";
        }
    }

    private void ReturnFromNestedLookup()
    {
        isLookupMode = false;

        // Ensure stacks are cleared only if they contain data to prevent InvalidOperationException
        if (typeStack.Any()) typeStack.Pop();
        if (keyStack.Any()) keyStack.Pop();
    }
    #endregion

    #region Add
    /// <summary>
    /// saves the new Entity and sends to field of father.
    /// </summary>
    /// <returns></returns>
    private async Task SendNestedToField()
    {
        // 1. Safety check: ensure we have context to return to
        if (!keyStack.Any() || !nestingStack.Any())
        {
            pageErrorMessage = "Nesting Error: Navigation context lost.";
            return;
        }

        isLoading = true;
        try
        {
            // 2. Map and "Save" the current nested level into an object
            var completedEntity = await SaveNestedToField();

            if (completedEntity != null)//the insert failed - No DB entity
            {
                // 3. Pop the context for the level we just finished
                string fieldName = keyStack.Pop();
                typeStack.Pop();
                nestingStack.Pop(); // Remove the finished buffer

                // 4. Assign the completed object to the next level up
                if (nestingStack.Any())
                {
                    // Still in a sub-form, assign to the previous level's dictionary
                    nestingStack.Peek()[fieldName] = completedEntity;
                }
                else if (isEditMode)
                {
                    editData[fieldName] = completedEntity;
                }
                else
                {
                    // We are back at the primary Add/Edit form
                    newEntryData[fieldName] = completedEntity;
                }

                pageSuccessMessage = $"Successfully linked {completedEntity.GetType().Name}.";
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = "Link Error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TryToSendNestedToField()
    {
        brokenRules.Clear();

        CheckRules(CurrentNestedData,CurrentNestedType);

        if (brokenRules.Any())
        {
            pendingAction = SendNestedToField;
            showValidationPopup = true;
        }
        else
        {
            await SendNestedToField();
        }
    }

    private async Task<BaseEntity?> SaveNestedToField()
    {
        BaseEntity? entity = null;
        isLoading = true;
        pageErrorMessage = null;

        // 1. bring table configuration from registry (funcs)
        Type nestedEntityType = typeStack.Peek(); // We peek here; popping is handled by the caller or at the end

        //get the table configuration entry
        var registryEntry = _tableRegistry.FirstOrDefault(x => x.Value.EntityType == nestedEntityType);
        string? registryKey = registryEntry.Key; //get the key
        var config = registryEntry.Value; //get the registry


        if (config == null)
        {
            pageErrorMessage = $"Insert Error: No registry mapping found for {nestedEntityType.Name}";
            isLoading = false;
            return null;
        }

        try
        {
            // 2. Map data and perform the insert using the registry delegate
            //nestingStack.Peek() - pops in SendNestedToField
            var mappedEntity = MapDataToEntity(nestingStack.Peek(), nestedEntityType);
            var result = await config.Insert(mappedEntity);

            if (result.rows > 0)
            {
                // 3. Refresh and retrieve the newest record
                await RefreshData();

                // Access the updated data via the registry's key
                if (_tableData.TryGetValue(registryKey, out var dataList))
                {
                    // We order by Idx to find the record just inserted
                    entity = dataList.Cast<BaseEntity>().OrderBy(e => e.Idx).LastOrDefault();
                }

                pageSuccessMessage = $"Successfully created and linked {nestedEntityType.Name}!";

                // Auto-clear success message
                _ = Task.Delay(2500).ContinueWith(_ =>
                {
                    pageSuccessMessage = null;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                pageErrorMessage = /* "Insert failed: " +  */
                    (result.error ?? "Unknown database error.");
                return null;
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = "Insert Error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }

        return entity;
    }


    private void ReturnFromNestedInsert()
    {
        if (nestingStack.Count > 0)
        {
            nestingStack.Pop();
            typeStack.Pop();
            keyStack.Pop();
        }
    }
    #endregion
    #endregion

    #region Update
    /// <summary>
    /// copies SingleEntity data to editData
    /// </summary>
    /// <returns></returns>
    private async Task HandleUpdate()
    {
        if (targetId <= 0)
        {
            pageErrorMessage = "Please select a valid ID to delete.";
            return;
        }
        if (SingleEntity == null)
        {
            pageErrorMessage = "Pick an Entity (Try Clicking Go)";
            return;
        }

        editData.Clear();

        // Use Reflection to pull current values from SingleEntity into the dictionary
        var props = SingleEntity.GetType().GetProperties();
        foreach (var prop in props)
        {
            // Shove existing values into the edit dictionary
            editData[prop.Name] = prop.GetValue(SingleEntity) ?? "None";
        }

        isEditMode = true;
    }

    private async Task TryUpdate()
    {
        brokenRules.Clear();

        CheckRules(editData, _tableRegistry[activeTab].EntityType);

        if (brokenRules.Any())
        {
            pendingAction = UpdateEntity;
            showValidationPopup = true;
        }
        else
        {
            await UpdateEntity();
        }
    }


    private async Task UpdateEntity()
    {
        if (!_tableRegistry.TryGetValue(activeTab, out var config)) return;

        isLoading = true;

        try
        {
            // Use the same mapper used for Inserts
            IBaseDTO updateDto = MapDataToDTO(editData, config.DtoType);

            // Execute the registry-defined update
            var result = await config.Update(updateDto);

            if (result.rows >= 0)
            {
                await RefreshData();
                isEditMode = false;
                pageSuccessMessage = "Record updated successfully!";
            }
            else //-1 is error
            {
                pageErrorMessage = /* "Update failed: " + */ result.error;
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = "Update Error: " + ex.Message;
        }
        finally { isLoading = false; }
    }

    private IBaseDTO MapDataToDTO(Dictionary<string, object> data, Type dtoType)
    {
        var dto = (IBaseDTO)Activator.CreateInstance(dtoType)!;
        var props = dtoType.GetProperties(BindingFlags.Public | BindingFlags.Instance);
        object? originalEntity = isEditMode ? SingleEntity : null;

        foreach (var prop in props)
        {
            // 1. Mandatory Idx for the primary DTO
            if (prop.Name == "Idx" && data.TryGetValue("Idx", out var idxVal))
            {
                prop.SetValue(dto, Convert.ToInt32(idxVal));
                continue;
            }

            if (data.TryGetValue(prop.Name, out var newValue) && newValue != null)
            {
                try
                {
                    if (newValue == "None")
                    {
                        prop.SetValue(dto, null);
                    }
                    // 2. Handle Nested Entities (The Fix)
                    else if (newValue is BaseEntity nestedEntity)
                    {
                        var registryEntry = _tableRegistry.Values.FirstOrDefault(v => v.EntityType == nestedEntity.GetType());
                        if (registryEntry != null)
                        {
                            // Create a "Link-Only" DTO instance
                            var nestedDto = (IBaseDTO)Activator.CreateInstance(registryEntry.DtoType)!;

                            // ONLY set the Idx. This tells the API "Link to this ID"
                            // without sending prohibited nested values like 'Email' or 'Username'.
                            nestedDto.Idx = nestedEntity.Idx;

                            prop.SetValue(dto, nestedDto);
                        }
                    }
                    // 3. Handle Primitive Fields (Unchanged Logic)
                    else
                    {
                        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
                        var convertedNewValue = Convert.ChangeType(newValue, targetType);

                        // Only set if value changed compared to SingleEntity
                        object? originalValue = originalEntity?.GetType().GetProperty(prop.Name)?.GetValue(originalEntity);

                        if (originalValue == null || !convertedNewValue.Equals(originalValue))
                        {
                            if (prop.Name.Contains("Password", StringComparison.OrdinalIgnoreCase))
                            {
                                if (!string.IsNullOrWhiteSpace(newValue.ToString()))
                                    prop.SetValue(dto, TextHasher.Hash(newValue.ToString()));
                            }
                            else
                            {
                                prop.SetValue(dto, convertedNewValue);
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    pageErrorMessage = $"Mapping Error on '{prop.Name}': {ex.Message}";
                }
            }
        }
        return dto;
    }
