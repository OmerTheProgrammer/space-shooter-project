                GetById = async id => await api.GetPlayerAndGroupByIdx(id),
                Delete = id => api.DeletePlayerAndGroup(id),
                Insert = e => api.InsertPlayerAndGroup((PlayerAndGroup)e),
                Update = dto => api.UpdatePlayerAndGroup((PlayerAndGroupDTO)dto)
            },
            ["profileEditRequests"] = new()
            {
                EntityType = typeof(ProfileEditRequest),
                DtoType = typeof(ProfileEditRequestDTO),
                GetAll = async () => (await api.GetAllProfileEditRequests()).Cast<object>(),
                GetById = async id => await api.GetProfileEditRequestByIdx(id),
                Delete = id => api.DeleteProfileEditRequest(id),
                Insert = e => api.InsertProfileEditRequest((ProfileEditRequest)e),
                Update = dto => api.UpdateProfileEditRequest((ProfileEditRequestDTO)dto)
            },
            ["requestsData"] = new()
            {
                EntityType = typeof(RequestData),
                DtoType = typeof(RequestDataDTO),
                GetAll = async () => (await api.GetAllRequestsData()).Cast<object>(),
                GetById = async id => await api.GetRequestDataByIdx(id),
                Delete = id => api.DeleteRequestData(id),
                Insert = e => api.InsertRequestData((RequestData)e),
                Update = dto => api.UpdateRequestData((RequestDataDTO)dto)
            },
            ["runsInfo"] = new()
            {
                EntityType = typeof(RunInfo),
                DtoType = typeof(RunInfoDTO),
                GetAll = async () => (await api.GetAllRunsInfo()).Cast<object>(),
                GetById = async id => await api.GetRunInfoByIdx(id),
                Delete = id => api.DeleteRunInfo(id),
                Insert = e => api.InsertRunInfo((RunInfo)e),
                Update = dto => api.UpdateRunInfo((RunInfoDTO)dto)
            }
