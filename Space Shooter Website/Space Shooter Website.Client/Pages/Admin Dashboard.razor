    private async Task RefreshData()
    {
        isLoading = true;
        try
        {
            // Fetch all tables dynamically
            foreach (var key in _tableRegistry.Keys)
            {
                _tableData[key] = await _tableRegistry[key].GetAll();
            }
        }
        finally { isLoading = false; }
    }

    private void SetTab(string tabName)
    {
        activeTab = tabName;
        ResetPage();
    }

    private void ResetPage()
    {
        pageErrorMessage = null;
        isInsertMode = false;
        isLookupMode = false;
        isSelectByIdWindow = false;
        SingleEntity = null;
        targetId = 0;
    }
    #endregion

    #region Reflection & Data Getters
    ///<summary>
    ///returns the full table based on activeTab's name
    ///</summary>
    private IEnumerable<object> GetCurrentData()
    {
        return _tableData.TryGetValue(activeTab, out var data) ? data : Array.Empty<object>();
    }

    private PropertyInfo[] GetCurrentProperties()
    {
        if (!_tableRegistry.TryGetValue(activeTab, out var config)) return Array.Empty<PropertyInfo>();
        return GetPropertiesCached(config.EntityType);
    }

    private PropertyInfo[] GetSingleProperties()
    {
        if (SingleEntity == null) return Array.Empty<PropertyInfo>();
        return GetPropertiesCached(SingleEntity.GetType());
    }

    private PropertyInfo[] GetPropertiesCached(Type type)
    {
        if (type == null) { return null; }
        if (_propCache.TryGetValue(type, out var props)) return props;

        props = type.GetProperties(BindingFlags.Public | BindingFlags.Instance)
                    .OrderBy(p => p.Name)
                    .OrderByDescending(p => p.Name.Equals("Idx", StringComparison.OrdinalIgnoreCase))
                    .ToArray();

        _propCache[type] = props;
        return props;
    }

    private bool IsTypeEnum(Type t)
    {
        if (t.IsEnum) return true;
        Type? underlyingType = Nullable.GetUnderlyingType(t);
        return underlyingType != null && underlyingType.IsEnum;
    }
    #endregion

    #region SelectById & Delete
    private async Task FetchItemById()
    {
        if (targetId <= 0)
        {
            pageErrorMessage = "Id less or equals then 0, try diffrent one!";
            return;
        }
        else if (!_tableRegistry.ContainsKey(activeTab))
        {
            pageErrorMessage = "Table Unloaded! ";
            return;
        }

        isLoading = true;
        try
        {
            SingleEntity = await _tableRegistry[activeTab].GetById(targetId);
            if (SingleEntity == null) pageErrorMessage = "No record found with that ID.";
            else { isSelectByIdWindow = true; }
        }
        catch (Exception ex) { pageErrorMessage = $"Fetch failed: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task HandleDelete()
    {
        if (targetId <= 0)
        {
            pageErrorMessage = "Id less then 0, try diffrent one!";
            return;
        }
        else if (!_tableRegistry.ContainsKey(activeTab))
        {
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete ID {targetId} from {activeTab}?");
        if (!confirmed) return;

        isLoading = true;
        pageErrorMessage = null;

        try
        {
            var result = await _tableRegistry[activeTab].Delete(targetId);

            if (result.rows > 0)
            {
                SingleEntity = null;
                targetId = 0;
                await RefreshData();
            }
            else
            {
                pageErrorMessage = result.error ?? "Delete failed. Record might not exist or is protected by a foreign key.";
            }
        }
        catch (Exception ex) { pageErrorMessage = $"Delete Error: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task RefreshTable()
    {
        ResetPage();
        await RefreshData();
    }
    #endregion

    #region Insert:
    private RenderFragment RenderPropertyInput(PropertyInfo prop, Dictionary<string, object> dataSource) => __builder =>
    {
        var propName = prop.Name;
        var propType = prop.PropertyType;

        string inputBorderClass = (isEditMode && !isNestedInsertMode) ? "border-warning" : "border-secondary";

        // Skip Idx - it's handled by the DB
        if (propName.Equals("Idx", StringComparison.OrdinalIgnoreCase)) return;

        <div class="mb-3">
            <label class="form-label text-light">@propName</label>

            @if (propName.Contains("Password", StringComparison.OrdinalIgnoreCase))
            {
                <div class="input-group">
                    <input type="@(showPassword ? "text" : "password")" class="form-control bg-dark text-white @inputBorderClass"
                           value="@(dataSource.ContainsKey(propName) ? dataSource[propName] : "None")"
                           @onchange="@(e => dataSource[propName] = e.Value?.ToString() ?? "None")" />
                    <button class="button icon" type="button" @onclick="() => showPassword = !showPassword">
                        <i class="fa @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
            }
            else if (propType == typeof(bool) || propType == typeof(bool?))
            {
                <select class="form-select bg-dark text-white @inputBorderClass"
                        @onchange="@(e => dataSource[propName] = bool.Parse(e.Value?.ToString() ?? "false"))">
                    <option value="false">False</option>
                    <option value="true">True</option>
                </select>
            }
            else if (IsTypeEnum(propType))
            {
                <select class="form-select bg-dark text-white @inputBorderClass"
                        value="@dataSource[propName]?.ToString()"
                        @onchange="@(e => {
                        var targetType = Nullable.GetUnderlyingType(propType) ?? propType;
                        dataSource[propName] = Enum.Parse(targetType, e.Value?.ToString() ?? "0");
                        StateHasChanged(); // Force the UI thread to sync
                    })">
                    @foreach (var val in Enum.GetValues(Nullable.GetUnderlyingType(propType) ?? propType))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            }
            else if (propType == typeof(DateTime) || propType == typeof(DateTime?))
            {
                <input type="date" class="form-control bg-dark text-white @inputBorderClass"
                       value="@(dataSource.TryGetValue(propName, out var dateVal) &&
                                                       dateVal is DateTime dt ? dt.ToString("yyyy-MM-dd") : null)"
                        @onchange="@(e => {
                                  if (DateTime.TryParse(e.Value?.ToString(), out var result))
                           dataSource[propName] = result;
                   })" />
        }
        else if (propType.IsClass && propType != typeof(string))
        {
    @* This is for nested entities (e.g., Player inside a RunInfo) *@
    <div class="d-flex gap-2">
        <button class="btn btn-outline-info btn-sm" @onclick='() => OpenLookup(propType, propName)'>
            <i class="fa fa-search"></i> Select Existing
        </button>
        <button class="btn btn-outline-success btn-sm" @onclick='() => OpenNestedInsert(propType, propName)'>
            <i class="fa fa-plus-lg"></i> Create New
        </button>
        @if (dataSource.TryGetValue(propName, out var val))
                {
        <div class="mt-2 p-2 rounded bg-dark border border-success shadow-sm">
            @if(val != "None" && val != null)
                        {
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-success">
                    <i class="fa fa-link-45deg"></i> Linked!
                </span>
                <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => dataSource.Remove(propName)">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </div>
                        }
            <div class="text-info small fw-mono" style="word-break: break-all; font-family: 'Courier New', monospace; line-height: 1.2;">
                @GetFullPreview(val)
            </div>
        </div>
                }
    </div>
        }
        else
    {
        <input type="@(propType == typeof(DateTime) ? "date" : "text")"
               class="form-control bg-dark text-white @inputBorderClass"
               value="@(dataSource.ContainsKey(propName) ? dataSource[propName] : "None")"
               @onchange="@(e => dataSource[propName] = e.Value?.ToString() ?? "None")" />
    }
</div>
    };

private void OpenNestedInsert(Type type, string parentKey)
{
    nestingStack.Push(new Dictionary<string, object>());
    typeStack.Push(type);
    keyStack.Push(parentKey);
    StateHasChanged();
}

/// <summary>
/// returns string virsion of entity to diplaiy in nesting
/// </summary>
/// <param name="val"></param>
/// <returns></returns>
private string GetFullPreview(object? val)
{
    if (val == null) return "None";

    // Scenario A: Data is in a Dictionary (New Entry being built)
    if (val is Dictionary<string, object> dict)
    {
        if (dict.Count == 0) return "New Entity (Empty)";
        // Joins all key-value pairs into a single readable string
        return string.Join(" | ", dict.Select(kvp => $"{kvp.Key}: {kvp.Value}"));
    }

    // Scenario B: Data is a real Entity (Existing record from DB)
    if (val is BaseEntity entity)
    {
        var props = GetPropertiesCached(entity.GetType())
            .Select(p => $"{p.Name}: {p.GetValue(entity)}");
        return string.Join(" | ", props);
    }

    return val.ToString() ?? "Linked";
}
