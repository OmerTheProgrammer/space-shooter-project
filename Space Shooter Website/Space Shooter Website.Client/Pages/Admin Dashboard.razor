@page "/Admin Dashboard"
@using System.Reflection
@using Model.Tables
@using Model.Entitys
@using Client_Manager___API
@using Space_Shooter_Website.Client.Support_Classes
@inject IApiService api
@inject NavigationManager NavManager
@inject Session session
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Admin Dashboard</PageTitle>

<section class="admin-dashboard">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col text-center">
                <h1 class="display-4 text" style="margin-bottom:0px;">Dashboard</h1>
                <p class="text-muted text" style="margin-bottom:0px;">Managing: @activeTab</p>
            </div>
        </div>

         @if (isLoading) @*מסך טעינה*@
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading Data...</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(pageErrorMessage)) @*מסך שגיאה*@
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Error:</strong> @pageErrorMessage
                <button type="button" class="btn-close" @onclick="GoBackFromError" aria-label="Close"></button>
            </div>
        }
        else if (SingleEntity != null) @*מסך Select By Id*@
        {
            <div class="card mt-4 border-primary shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Details for ID: @targetId</h5>
                </div>
                <div class="card-body bg-light">
                    <div class="row">
                        @foreach (var prop in GetSingleProperties())
                        {
                            <div class="col-md-4 mb-3">
                                <label class="fw-bold text-dark">@prop.Name:</label>
                                <div class="p-2 border rounded bg-white text-dark">
                                    @prop.GetValue(SingleEntity)
                                </div>
                            </div>
                        }
                    </div>
                    <button class="btn btn-secondary btn-sm" @onclick="() => SingleEntity = null">Clear View</button>
                </div>
            </div>
        }
        else if (isInsertMode)@*מסך Insert*@
        {
            <div class="card mb-4 border-success shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add New Entry to @activeTab</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var key in newEntryData.Keys.ToList())
                        {
                            <div class="col-md-4 mb-3">
                                <label class="fw-bold text">@key</label>
                                @if (newEntryData[key] is int)
                                {
                                    <input type="number" class="form-control"
                                           value="@newEntryData[key]"
                                           @onchange="@(e => newEntryData[key] = int.Parse(e.Value.ToString()))" />
                                }
                                else
                                {
                                    <input type="text" class="form-control"
                                           value="@newEntryData[key]"
                                           @onchange="@(e => newEntryData[key] = e.Value.ToString())" />
                                }
                            </div>
                        }
                    </div>
                    <div class="mt-2">
                        <button class="btn btn-primary" @onclick="HandleInsert">Save Entry</button>
                        <button class="btn btn-secondary" @onclick="() => isInsertMode = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
        else @*מסך Select ALL*@
        {
            <div class="card shadow">
                <div class="card-header bg-dark">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "users" ? "active" : "")"
                                @onclick='() => SetTab("users")'>
                                Users
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "admins" ? "active" : "")"
                                @onclick='() => SetTab("admins")'>
                                Admins
                        </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "players" ? "active" : "")"
                                    @onclick='() => SetTab("players")'>
                                Players
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "groups" ? "active" : "")"
                                    @onclick='() => SetTab("groups")'>
                                Groups
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "playersAndgroups" ? "active" : "")"
                                    @onclick='() => SetTab("playersAndgroups")'>
                                PlayersAndGroups
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "enemiesInLastLevel" ? "active" : "")"
                                    @onclick='() => SetTab("enemiesInLastLevel")'>
                                EnemiesInLastLevel
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "profileEditRequests" ? "active" : "")"
                                    @onclick='() => SetTab("profileEditRequests")'>
                                ProfileEditRequests
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "requestsData" ? "active" : "")"
                                    @onclick='() => SetTab("requestsData")'>
                                RequestsData
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "runsInfo" ? "active" : "")"
                                    @onclick='() => SetTab("runsInfo")'>
                                RunsInfo
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 border-end">
                            <h4 class="title">Controls</h4>
                            <div class="form-group mb-3">
                                <label class="subtitle">Target ID:</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" @bind="targetId" />
                                    <button class="btn btn-primary" @onclick="FetchItemById">Go</button>
                                </div>
                            </div>
                            <div class="d-grid gap-2">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-success" @onclick="RefreshData">Refresh Table</button>

                                    @if (targetId > 0)
                                    {
                                        <button class="btn btn-danger" @onclick="HandleDelete">
                                            Delete ID: @targetId from @activeTab
                                        </button>
                                    }
                                    else
                                    {
                                        <p class="text">Search for an entity, if you wish to delete it.</p>
                                    }

                                    <button class="btn btn-success" @onclick="OpenInsertModal">Add New Entry</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="table-responsive" style="max-height: 600px;">
                                <table class="table table-hover table-striped border">
                                    <thead class="table-dark">
                                        <tr>
                                            @foreach (var prop in GetCurrentProperties())
                                            {
                                                <th class="subtitle">@prop.Name</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in GetCurrentData())
                                        {
                                            <tr>
                                                @foreach (var prop in GetCurrentProperties())
                                                {
                                                    <td class="text">@prop.GetValue(item)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool isLoading = true;
    private string activeTab = "users";
    private string pageErrorMessage;
    private int targetId;
    private Dictionary<string, object> newEntryData = new();
    private bool isInsertMode = false;

    private UsersTable usersTable = new();
    private AdminsTable adminsTable = new();
    private PlayersTable playersTable = new();
    private GroupsTable groupsTable = new();
    private PlayersAndGroupsTable playersAndgroupsTable = new();
    private EnemiesInLastLevelTable enemiesInLastLevelTable = new();
    private ProfileEditRequestsTable profileEditRequestsTable = new();
    private RequestsDataTable requestsDataTable = new();
    private RunsInfoTable runsInfoTable = new();

    private BaseEntity SingleEntity;
    private PropertyInfo[] GetSingleProperties()
    {
        if (SingleEntity == null) return Array.Empty<PropertyInfo>();
        return SingleEntity.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);
    }

    private void GoBackFromError()
    {
        // Clear the error message to return to the default view
        pageErrorMessage = null;

        // Ensure we aren't stuck in Insert mode or Single Entity view
        isInsertMode = false;
        SingleEntity = null;

        // Optional: Reset targetId if the error was caused by a bad search
        targetId = 0;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!session.IsAdmin)
        {
            NavManager.NavigateTo("/Admin Connection");
            return;
        }
        await RefreshData();
    }

    private async Task RefreshData()
    {
        isLoading = true;
        try
        {
            usersTable = await api.GetAllUsers();
            adminsTable = await api.GetAllAdmins();
            playersTable = await api.GetAllPlayers();
            groupsTable = await api.GetAllGroups();
            playersAndgroupsTable = await api.GetAllPlayersAndGroups();
            enemiesInLastLevelTable = await api.GetAllEnemiesInLastLevel();
            profileEditRequestsTable = await api.GetAllProfileEditRequests();
            requestsDataTable = await api.GetAllRequestsData();
            runsInfoTable = await api.GetAllRunsInfo();
        }
        finally { isLoading = false; }
    }

    private void SetTab(string tabName) => activeTab = tabName;

    // --- Reflection Funcs ---
    ///<summary>
    ///returns the full table based on activeTab's name
    ///</summary>
    private IEnumerable<object> GetCurrentData()
    {
        return activeTab switch
        {
            "admins" => adminsTable,
            "users" => usersTable, //these implement IEnumerable
            "players" => playersTable,
            "groups" => groupsTable,
            "playersAndgroups" => playersAndgroupsTable,
            "enemiesInLastLevel" => enemiesInLastLevelTable,
            "profileEditRequests" => profileEditRequestsTable,
            "requestsData" => requestsDataTable,
            "runsInfo" => runsInfoTable,
            _ => new List<object>()
        };
    }

    private PropertyInfo[] GetCurrentProperties()
    {
        var data = GetCurrentData();
        var firstItem = data.Cast<object>().FirstOrDefault();//gets the first item 
        if (firstItem == null) return Array.Empty<PropertyInfo>(); // or empty prop set if first item is null.

        // Gets all public properties of the specific object (User, Admin, Player or others)
        return firstItem.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);
    }

    private async Task FetchItemById()
    {
        if (targetId <= 0) return;

        isLoading = true;
        try
        {
            // just ensure the result is assigned to SingleEntity
            SingleEntity = activeTab switch
            {
                "users" => await api.GetUserByIdx(targetId),
                "admins" => await api.GetAdminByIdx(targetId),
                "players" => await api.GetPlayerByIdx(targetId),
                "groups" => await api.GetGroupByIdx(targetId),
                "playersAndgroups" => await api.GetPlayerAndGroupByIdx(targetId),
                "enemiesInLastLevel" => await api.GetEnemyInLastLevelByIdx(targetId),
                "profileEditRequests" => await api.GetProfileEditRequestByIdx(targetId),
                "requestsData" => await api.GetRequestDataByIdx(targetId),
                "runsInfo" => await api.GetRunInfoByIdx(targetId),
                _ => null
            };

            if (SingleEntity == null)
            {
                pageErrorMessage = "No record found with that ID.";
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = $"Fetch failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDelete()
    {
        if (targetId <= 0)
        {
            pageErrorMessage = "Please select a valid ID to delete.";
            return;
        }

        // Confirmation logic (Simple browser confirm for now)
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete ID {targetId} from {activeTab}?");
        if (!confirmed) return;

        isLoading = true;
        pageErrorMessage = null;

        try
        {
            (int rows, string? error) result = activeTab switch
            {
                "users" => await api.DeleteUser(targetId),
                "admins" => await api.DeleteAdmin(targetId),
                "players" => await api.DeletePlayer(targetId),
                "groups" => await api.DeleteGroup(targetId),
                "playersAndgroups" => await api.DeletePlayerAndGroup(targetId),
                "enemiesInLastLevel" => await api.DeleteEnemyInLastLevel(targetId),
                "runsInfo" => await api.DeleteRunInfo(targetId),
                "requestsData" => await api.DeleteRequestData(targetId),
                "profileEditRequests" => await api.DeleteProfileEditRequest(targetId),
                _ => (0, "Delete logic not implemented for this table.")
            };

            if (result.rows > 0)
            {
                // Success! Clear the view and refresh
                SingleEntity = null;
                targetId = 0;
                await RefreshData();
                // Optional: Success message
                Console.WriteLine("Deleted successfully.");
            }
            else
            {
                pageErrorMessage = result.error ?? "Delete failed. Record might not exist or is protected by a foreign key.";
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = $"Delete Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenInsertModal()
    {
        isLoading = true;
        newEntryData.Clear();
        var props = GetCurrentProperties();

        foreach (var prop in props)
        {
            // Skip 'idx' or 'Idx' because the Database generates it automatically (IDENTITY)
            if (prop.Name.Equals("idx", StringComparison.OrdinalIgnoreCase)) continue;

            // Initialize with default values based on type
            if (prop.PropertyType == typeof(int)) newEntryData[prop.Name] = 0;
            else if (prop.PropertyType == typeof(string)) newEntryData[prop.Name] = "";
            else newEntryData[prop.Name] = null;
        }
        isInsertMode = true;
        isLoading = false;
    }

    private async Task HandleInsert()
    {
        isLoading = true;
        try
        {
            (int rows, string? error) result = (0, "Table not mapped");

            switch (activeTab)
            {
                case "users":
                    var newUser = new User
                    {
                        Username = newEntryData["Username"].ToString(),
                        Email = newEntryData["Email"].ToString(),
                        //must pull all data to every entity, 
                    };
                    //result = await api.InsertUser(newUser);
                    pageErrorMessage = newUser.ToString();
                    break;

                case "admins":
                    var newAdmin = new Admin {
                        Username = newEntryData["Username"].ToString()

                    };
                    //result = await api.InsertAdmin(newAdmin);
                    pageErrorMessage = newAdmin.ToString();
                    break;

                case "groups":
                    var newGroup = new Group
                    {
                        Name = newEntryData["Name"].ToString(),
                        Score = (int)newEntryData["Score"]
                    };
                    pageErrorMessage = newGroup.ToString();
                    //result = await api.InsertGroup(newGroup);
                    break;
            }

            if (result.rows > 0)
            {
                isInsertMode = false;
                await RefreshData();
            }
            else
            {
                pageErrorMessage = result.error ?? "Insert failed.";
            }
        }
        catch (Exception ex)
        {
            pageErrorMessage = "Insert Error: " + ex.Message;
        }
        finally { isLoading = false; }
    }
}