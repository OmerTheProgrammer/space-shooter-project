            return;
        }

        // Initialize the Master Registry - This is the ONLY place you map tables
        _tableRegistry = new Dictionary<string, TableConfig>
        {
            ["users"] = new()
            {
                EntityType = typeof(User),
                DtoType = typeof(UserDTO),
                GetAll = async () => (await api.GetAllUsers()).Cast<object>(),
                GetById = async id => await api.GetUserByIdx(id),
                Delete = id => api.DeleteUser(id),
                Insert = e => api.InsertUser((User)e),
                Update = dto => api.UpdateUser((UserDTO)dto)
            },
            ["admins"] = new()
            {
                EntityType = typeof(Admin),
                DtoType = typeof(AdminDTO),
                GetAll = async () => (await api.GetAllAdmins()).Cast<object>(),
                GetById = async id => await api.GetAdminByIdx(id),
                Delete = id => api.DeleteAdmin(id),
                Insert = e => api.InsertAdmin((Admin)e),
                Update = dto => api.UpdateAdmin((AdminDTO)dto)
            },
            ["players"] = new()
            {
                EntityType = typeof(Player),
                DtoType = typeof(PlayerDTO),
                GetAll = async () => (await api.GetAllPlayers()).Cast<object>(),
                GetById = async id => await api.GetPlayerByIdx(id),
                Delete = id => api.DeletePlayer(id),
                Insert = e => api.InsertPlayer((Player)e),
                Update = dto => api.UpdatePlayer((PlayerDTO)dto)
            },
