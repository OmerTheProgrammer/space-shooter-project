@page "/Admin Dashboard"
@using Model.Tables
@using Model.Entitys
@using Client_Manager___API
@using Space_Shooter_Website.Client.Support_Classes
@inject IApiService api
@inject NavigationManager NavManager
@inject Session session
@rendermode InteractiveServer

<PageTitle>Admin Dashboard</PageTitle>

<section class="admin-dashboard">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col text-center">
                <h1 class="display-4 text">Admin Management System</h1>
                <p class="text-muted text">Connected to: @apiBaseUrl</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading Data...</span>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow">
                <div class="card-header bg-dark">
                    <ul class="nav nav-tabs card-header-tabs" id="adminTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "users" ? "active" : "")"
                            @onclick='() => SetTab("users")'>Users</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "admins" ? "active" : "")"
                            @onclick='() => SetTab("admins")'>Admins</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "players" ? "active" : "")"
                            @onclick='() => SetTab("players")'>Players</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 border-end">
                            <h4 class="title">Manage @activeTab.ToUpper()</h4>
                            <div class="form-group mb-3">
                                <label class="subtitle">Target ID:</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" @bind="targetId" placeholder="ID" />
                                    <button class="btn btn-outline-primary" @onclick="FetchItemById">Go</button>
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                                <button class="btn btn-success">Add New</button>
                                <button class="btn btn-warning">Update</button>
                                <button class="btn btn-danger">Delete</button>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="table-responsive" style="max-height: 600px;">
                                @if (activeTab == "users")
                                {
                                    <table class="table table-hover table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th class="subtitle">ID</th>
                                                <th class="subtitle">Username</th>
                                                <th class="subtitle">Email</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in usersTable)
                                            {
                                                <tr>
                                                    <td class ="text">@user.Idx</td>
                                                    <td class="text">@user.Username</td>
                                                    <td class="text">@user.Email</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else if (activeTab == "admins")
                                {
                                    <table class="table table-hover table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th class="subtitle">ID</th>
                                                <th class="subtitle">Admin Name</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var admin in adminsTable)
                                            {
                                                <tr>
                                                    <td class="text">@admin.Idx</td>
                                                    <td class ="text">@admin.Username</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool isLoading = true;
    private string activeTab = "users";
    private int targetId;
    private string apiBaseUrl = "";

    // Data Tables from your API
    private UsersTable usersTable = new();
    private AdminsTable adminsTable = new();
    private PlayersTable playersTable = new();

    protected override async Task OnInitializedAsync()
    {
        // Security Check: Ensure user is admin
        if (!session.IsAdmin)
        {
            NavManager.NavigateTo("/Admin Connection");
            return;
        }

        await RefreshData();
    }

    private async Task RefreshData()
    {
        isLoading = true;
        try
        {
            // Fetching data using your newly fixed API Service
            usersTable = await api.GetAllUsers();
            adminsTable = await api.GetAllAdmins();
            playersTable = await api.GetAllPlayers();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetTab(string tabName) => activeTab = tabName;

    private async Task FetchItemById()
    {
        // Example: Fetching specific admin using your GetAdminByIdx method
        if (activeTab == "admins")
        {
            var admin = await api.GetAdminByIdx(targetId);
            // logic to populate form...
        }
    }
}