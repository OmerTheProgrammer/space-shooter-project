@inherits LayoutComponentBase

<div class="page">
    <nav class="navbar m_container navbar-expand-lg" id="navbar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/assets/icon.png" id="icon" class="logo" alt="Logo" />
                <img src="/assets/mainmenu/header.png" id="header" alt="Header" />
			</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link nav_text" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link nav_text" href="Credits">Credits</a></li>

                    @* Logic replaces Response.Write *@
                    @if (IsLoggedIn)
                    {
                        <li class="nav-item"><a class="nav-link nav_text" href="Levels">Levels</a></li>
                        <li class="nav-item"><a class="nav-link nav_text" href="Profile">Hello</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link nav_text" href="Register">Register</a></li>
                        <li class="nav-item"><a class="nav-link nav_text" href="Login">Log In</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <div style="margin-top:40px;"></div>
        @Body @* This is where your pages load! *@
    </main>

    <footer class="container-fluid">
        <div class="row">
            <div class="col-md-12 text-center">
                <a href="https://github.com/OmerTheProgrammer" target="_blank" class="link">
                    <i class="fa-brands fa-github"></i> Git Hub
                </a>
            </div>
        </div>
    </footer>
</div>

@code {
    // For now, we hardcode this. Later we will use your ApiService.
    private bool IsLoggedIn = false;
}