@inject Session session
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject IApiService apiService

@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="/Assets/icon.png" class="logo" style="width:50px; height:50px; margin-right:10px;" alt="Ship" />
            <img src="/Assets/Header.png" id="header" style="max-width:200px;" alt="Space Shooter" />
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav justify-content-center w-75">
                <li class="nav-item">
                    <NavLink class="nav-link nav_text" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link nav_text" href="Credits">Credits</NavLink>
                </li>

                @if (!session.IsLoggedIn) //isn't logged in
                {
                    @* Only show these if no one is logged in *@
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Register">Register</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Log In">Log In</NavLink>
                    </li>
                }
                else // is logged in
                {
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Profile">Hello (@session.CurrentUser?.Username)!</NavLink>
                    </li>

                    @if (session.IsPlayer)
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Level Selection">Level Selection</NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Groups Board">Squadrons</NavLink>
                        </li>
                    }

                    @if (session.IsAdmin) // and is an admin
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Players Requests">Player Requests</NavLink>
                        </li>

                        @if (IsWorkLongerThenAdmin(365)) // Is admin for more than a year
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link nav_text admin unlocked" href="Admin Dashboard">
                                    Admin Dashboard
                                </NavLink>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <div class="nav-link nav_text admin locked"
                                     data-tooltip="Must be an admin 1+ years to open!">
                                    Admin Dashboard
                                </div>
                            </li>

                        }
                    }
                    else // and is not an admin
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Admin Connection">Admin Connection</NavLink>
                        </li>
                    }

@*                     <li class="nav-item">
                        <button class="nav-link nav_text btn btn-link button" @onclick="HandleLogout">Logout (@session.CurrentUser?.Username)</button>
                    </li> *@
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    private Admin CurrentAdmin;
    protected override void OnInitialized()
    {
        // Subscribe to session changes
        session.UpdateScreenFunc += RefreshNavbar;
        //updated the game we move in site not left it.
        NavManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (session.CurrentUser != null)
        {
            CurrentAdmin = await apiService.GetAdminByIdx(session.CurrentUser.Idx);
        }
    }

    /// <summary>
    /// returns whether current admin worked longer then (param) days
    /// </summary>
    /// <param name="DaysCount">time to compare in days</param>
    /// <returns></returns>
    public bool IsWorkLongerThenAdmin(int DaysCount)
    {
        if (CurrentAdmin != null && CurrentAdmin.StartDate != null)
        {
            TimeSpan? timeAsAdmin = (DateTime.Now - CurrentAdmin.StartDate);
            return timeAsAdmin.Value.TotalDays >= DaysCount;//didn't have total years for some reason
        }
        return false;
    }

    private void RefreshNavbar()
    {
        // InvokeAsync ensures the refresh happens on the UI thread
        InvokeAsync(StateHasChanged);
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        //Set to true so the current page's 'beforeunload' (if any) is ignored
        await JS.InvokeVoidAsync("markAsInternalNav");
        //Reset to false on  new loaded page
    }

    public void Dispose()
    {
        // Always unsubscribe to avoid memory leaks
        session.UpdateScreenFunc -= RefreshNavbar;
        NavManager.LocationChanged -= HandleLocationChanged;
    }
}