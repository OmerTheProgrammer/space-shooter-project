@using Space_Shooter_Website.Client.Support_Classes
@inject Session session
@inject NavigationManager NavManager

@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="/Assets/icon.png" class="logo" style="width:50px; height:50px; margin-right:10px;" alt="Ship" />
            <img src="/Assets/MainMenu/Header.png" id="header" style="max-width:200px;" alt="Space Shooter" />
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav justify-content-center w-75">
                <li class="nav-item">
                    <NavLink class="nav-link nav_text" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link nav_text" href="Credits">Credits</NavLink>
                </li>

                @if (!session.IsLoggedIn) //isn't logged in
                {
                    @* Only show these if no one is logged in *@
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Register">Register</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Log In">Log In</NavLink>
                    </li>
                }
                else // is logged in
                {
                    <li class="nav-item">
                        <NavLink class="nav-link nav_text" href="Profile">Hello (@session.CurrentUser?.Username)!</NavLink>
                    </li>

                    @if (session.IsPlayer)
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Level Selection">Level Selection</NavLink>
                        </li>
                    }

                    @if (session.IsAdmin) // and is an admin
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Admin Dashboard">Admin Dashboard</NavLink>
                        </li>
                    }
                    else // and is not an admin
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link nav_text" href="Admin Connection">Admin Connection</NavLink>
                        </li>
                    }

@*                     <li class="nav-item">
                        <button class="nav-link nav_text btn btn-link button" @onclick="HandleLogout">Logout (@session.CurrentUser?.Username)</button>
                    </li> *@
                }
            </ul>
        </div>
    </div>
</nav>

