@page "/Register"
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Register - Space Shooter</PageTitle>

<section class="login-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 login-card">
                <div class="text-center mb-4">
                    <img src="Assets/User Avatars\user.png" class="user-avatar" alt="User Icon" />
                    <h1 class="title mt-3">Register</h1>
                </div>

                <div class="form-group mb-3">
                    <label class="login-label">Pilot Name:</label>
                    <input type="text" @bind="username" class="login-input" placeholder="Enter username..." />
                </div>

                <div class="form-group mb-4">
                    <label class="login-label">Password:</label>
                    <input type="password" @bind="password" class="login-input" placeholder="Enter password..." />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-text mb-3 text-center">@errorMessage</div>
                }

                <div class="row">
                    <div class="col-4">
                        <button class="btn-side" @onclick="FillDefault">DEFAULT</button>
                    </div>
                    <div class="col-4">
                        <button class="btn-submit" @onclick="HandleLogin">SUBMIT</button>
                    </div>
                    <div class="col-4">
                        <button class="btn-side" @onclick='() => NavManager.NavigateTo("register")'>REGISTER</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private void FillDefault()
    {
        username = "user";
        password = "p@55word";
        errorMessage = ""; // Clear errors
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        // For now, mirroring your old logic: show alert and move to selection
        await JS.InvokeVoidAsync("alert", $"Pilot Identified: {username}");

        // Eventually, you'll put your DB check here!
        NavManager.NavigateTo("Level Selection");
    }
}