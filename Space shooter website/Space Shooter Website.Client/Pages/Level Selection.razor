@page "/LevelSelection"
@using Space_Shooter_Website.Client.Support_Classes
@inject Session session
@inject NavigationManager NavManager
@rendermode InteractiveWebAssembly

<PageTitle>Mission Control - Space Shooter</PageTitle>

<div class="selection-screen">
    @* --- Header עם כפתורי בקרה --- *@
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="title">LEVEL SELECTION</h1>
        </div>
        <div class="col-md-6 text-end">
            <button class="top-btn" @onclick="() => showScores = true">
                <img src="Assets/UI/achievement.png" class="btn-icon" />
            </button>
            <button class="top-btn" @onclick="() => showSettings = true">
                <img src="Assets/UI/cogwheel.png" class="btn-icon" />
            </button>
            <button class="top-btn" @onclick="() => showInfo = true">
                <img src="Assets/UI/info.png" class="btn-icon" />
            </button>
        </div>
    </div>

    @* --- אזור בחירת השלבים (Scrollable) --- *@
    <div class="level-container shadow-lg">
        @for (int i = 1; i <= 30; i++)
        {
            int levelNum = i;
            bool isLocked = levelNum > maxUnlockedLevel;

            <button class="level-btn @(isLocked ? "locked" : "")"
                    disabled="@isLocked"
                    @onclick="() => StartLevel(levelNum)">
                @if (isLocked)
                {
                    <img src="Assets/UI/lock.png" class="lock-img" />
                }
                else
                {
                    @levelNum
                }
            </button>
        }
    </div>
</div>

@* --- פופאפים (Modals) --- *@

@if (showScores)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal p-4">
            <h2 class="text-cyan mb-3">Scoreboard</h2>
            <div class="score-list">
                @* כאן תבוא לולאה על הציונים מה-DB בעתיד *@
                <p class="text-white">Last Score: 1,000 pts</p>
                <p class="text-muted small">More scores coming soon...</p>
            </div>
            <button class="btn-side mt-3" @onclick="() => showScores = false">CLOSE</button>
        </div>
    </div>
}

@if (showSettings)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal p-4">
            <img src="Assets/Main_Menu/Setting/Header.png" class="img-fluid mb-4" style="max-height: 50px;" />

            <div class="d-flex align-items-center mb-3">
                <button class="btn-icon-only" @onclick="ToggleMusic">
                    <img src="@(isMusicOn ? "Assets/Main_Menu/BTNs_Active/Music_BTN.png" : "Assets/Main_Menu/Setting/Music_BTN.png")" />
                </button>
                <img src="Assets/Main_Menu/Setting/Music.png" class="setting-text-img" />
            </div>

            <div class="d-flex align-items-center mb-4">
                <button class="btn-icon-only" @onclick="ToggleSound">
                    <img src="@(isSoundOn ? "Assets/Main_Menu/BTNs_Active/Sound_BTN.png" : "Assets/Main_Menu/Setting/Sound_BTN.png")" />
                </button>
                <img src="Assets/Main_Menu/Setting/Sound.png" class="setting-text-img" />
            </div>

            <button class="btn-side" @onclick="() => showSettings = false">SAVE & CLOSE</button>
        </div>
    </div>
}

@if (showInfo)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal info-modal p-4 text-start">
            <h2 class="text-cyan border-bottom">CONTROLS</h2>
            <p class="mt-3"><strong>Move:</strong> Arrow Keys or WASD</p>
            <p><strong>Shoot:</strong> Space Bar</p>
            <p><strong>Pause:</strong> P Key</p>
            <p class="text-danger mt-3"><em>Tip: If buttons get stuck, click them again.</em></p>
            <button class="btn-side mt-4 w-100" @onclick="() => showInfo = false">UNDERSTOOD</button>
        </div>
    </div>
}

@code {
    private int maxUnlockedLevel = 1; // ימשך מה-DB בעתיד
    private bool showScores, showSettings, showInfo;
    private bool isMusicOn = true, isSoundOn = true;

    protected override void OnInitialized()
    {
        // בעתיד: maxUnlockedLevel = session.CurrentUser.MaxLevel;
    }

    private void StartLevel(int level)
    {
        // session.CurrentLevel = level;
        NavManager.NavigateTo("Game");
    }

    private void ToggleMusic() => isMusicOn = !isMusicOn;
    private void ToggleSound() => isSoundOn = !isSoundOn;
}