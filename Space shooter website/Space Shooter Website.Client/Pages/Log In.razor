@page "/Log In"
@* adding global libs*@
@using Model.Entitys
@using Model.Tables
@using Client_Manager___API
@using Space_Shooter_Website.Client.Support_Classes
@* adding global vars*@
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IApiService api
@inject Session session
@rendermode InteractiveServer

<PageTitle>Log In - Space Shooter</PageTitle>

<section class="login-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class=@loginCardClass>
                <div class="text-center mb-4">
                    <img src="Assets/User Avatars\user.png" class="user-avatar" alt="User Icon" />
                    <h1 class="title mt-3">Log in</h1>
                </div>

                <div class="form-group mb-3">
                    <label class="login-label">Pilot Name:</label>
                    <input type="text" @bind="username" class="login-input" placeholder="Enter username..." />
                </div>

                <div class="form-group mb-4">
                    <label class="login-label">Password:</label>
                    <div class="password-wrapper" style="position: relative;">
                        <input type="@passwordInputType" @bind="password" class="login-input" placeholder="Enter password..." />
                        <button type="button" @onclick="TogglePasswordVisibility" class="btn-eye">
                            @(passwordInputType == "password" ? "👁️" : "🙈")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-text mb-3 text-center">@errorMessage</div>
                }

                <div class="row">
                    <div class="col-4">
                        <button class="btn-side" @onclick="FillDefault">DEFAULT</button>
                    </div>
                    <div class="col-4">
                        <button class="btn-submit" @onclick="HandleLogin">
                            @(isProcessing? scanningText : "SUBMIT")
                        </button>
                    </div>
                    <div class="col-4">
                        <button class="btn-side" @onclick='() => NavManager.NavigateTo("register")'>REGISTER</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isProcessing = false; // Prevents double-clicks
    private string loginCardClass = "col-md-6 login-card";
    private string passwordInputType = "password"; // Default to hidden
    private string scanningText = "SCANNING...";


    private void TogglePasswordVisibility()
    {
        passwordInputType = (passwordInputType == "password") ? "text" : "password";
    }

    private async Task TriggerError(string message)
    {
        errorMessage = message;
        loginCardClass = "col-md-6 login-card";
        StateHasChanged(); // Force Blazor to render without the shake

        await Task.Delay(10);

        loginCardClass = "col-md-6 login-card shake"; // Triggers the CSS shake
    }

    private void FillDefault()
    {
        username = "StarPilot_Ace";
        password = "p@55word";
        errorMessage = "";
        loginCardClass = "col-md-6 login-card";
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        isProcessing = true;

        // Reset the text immediately before starting the loop
        scanningText = "SCANNING...";
        _ = StartScanningAnimation();

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            // Use await here since TriggerError is now an async Task
            await TriggerError("INPUT ERROR: Please fill in all fields.");
            isProcessing = false;
            return;
        }

        try
        {
            var users_table = await api.GetAllUsers();

            // If the API returned a 'new T()' because of a catch block in ApiService
            if (users_table == null || !users_table.Any())
            {
                await TriggerError("COMMUNICATION FAILURE: Database is not responding.");
                return;
            }

            var user = users_table.Find(u =>
                u.Username == username &&
                u.Password == TextHasher.Hash(password)
            );

            if (user == null)
            {
                await TriggerError("IDENTIFICATION FAILED: Invalid credentials.");
                return;
            }
            else
            {
                session.CurrentUser = user;
                var admins = await api.GetAllAdmins();
                session.IsAdmin = admins.Any(a => a.Username == user.Username);

                NavManager.NavigateTo("Level Selection", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "SYSTEM ERROR: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
            scanningText = "SCANNING...";
        }
    }
    
    private async Task StartScanningAnimation()
    {
        string[] frames = { "SCANNING...", "SCANNING..", "SCANNING.", "SCANNING" };
        int i = 0;
        while (isProcessing)
        {
            scanningText = frames[i % frames.Length];
            i++;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300); // Speed of the dots disappearing
        }   
    }
}
